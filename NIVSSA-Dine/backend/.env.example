# =======================================================
# NIVSSA Dine Backend Environment Configuration
# =======================================================

# Port (Render assigns PORT automatically; for local, 5000 or 3000)
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nivssa-dine?retryWrites=true&w=majority

# Gmail SMTP Credentials for OTPs / Notifications
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Allowed Frontend URLs for CORS (comma-separated or single)
# Any *.vercel.app domain is already allowed automatically!
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app
